# ── Filesystem ──────────────────────────────────────────
# Root directory where bank statements are stored
# Organized by month: extractos/mayo_2026/, extractos/abril_2026/
STATEMENTS_DIR=/home/santiago/Personal/extractos

# ── YNAB ────────────────────────────────────────────────
# API base URL (do not change unless YNAB changes their API)
YNAB_BASE_URL=https://api.ynab.com/v1

# Personal Access Token — get it from https://app.ynab.com/settings/developer
YNAB_PAT=your_personal_access_token_here

# ── LLM Hosts ───────────────────────────────────────────
# Required only if you want to use the built-in interactive host (host.py)
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
